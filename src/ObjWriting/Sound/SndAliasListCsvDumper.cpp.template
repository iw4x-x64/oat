#options GAME (IW4, IW4MS)

#filename "Game/" + GAME + "/Sound/SndAliasListCsvDumper" + GAME + ".cpp"

#set WRITER_HEADER "\"SndAliasListCsvDumper" + GAME + ".h\""
#set FLAGS_HEADER "\"Game/" + GAME + "/Sound/SoundAliasFlags" + GAME + ".h\""

#if GAME == "IW4MS"
#define FEATURE_IW4MS
#endif

// This file was templated.
// See SndAliasListCsvDumper.cpp.template.
// Do not modify, changes will be lost.

#include WRITER_HEADER

#include "Csv/CsvStream.h"
#include "Dumping/ReferencedAssetName.h"
#include FLAGS_HEADER
#include "Sound/SoundAliasCommon.h"

#include <algorithm>
#include <format>
#include <string>
#include <type_traits>

using namespace GAME;

namespace
{
    const std::string HEADERS[]{
        "name",
        "sequence",
        "file",
        "vol_min",
        "vol_max",
        "pitch_min",
        "pitch_max",
        "dist_min",
        "dist_max",
        "channel",
        "type",
        "probability",
        "loop",
        "masterslave",
        "loadspec",
        "subtitle",
        "compression",
        "secondaryaliasname",
        "chainaliasname",
        "mixergroup",
        "volumefalloffcurve",
        "startdelay",
        "speakermap",
        "reverb",
        "lfe percentage",
        "center percentage",
        "platform",
        "envelop_min",
        "envelop_max",
        "envelop percentage",
        "velocity_min",

        "master percentage",
        "unknown flags",
        "speakermap default",
        "speakermap mono 2speaker",
        "speakermap mono 6speaker",
        "speakermap stereo 2speaker",
        "speakermap stereo 6speaker",
    };

    class Dumper
    {
    public:
        explicit Dumper(std::ostream& stream)
            : m_csv(stream)
        {
        }

        void Dump(const snd_alias_list_t& aliasList)
        {
            for (const auto& header : HEADERS)
                m_csv.WriteColumn(header);
            m_csv.NextRow();

            for (auto i = 0; i < aliasList.count; i++)
                DumpAlias(aliasList.head[i]);
        }

    private:
        static std::string Str(const char* value)
        {
            return value ? value : "";
        }

        static std::string Num(const float value)
        {
            return std::format("{}", value);
        }

        static std::string Num(const int value)
        {
            return std::format("{}", value);
        }

        static std::string SoundFileName(const SoundFile* soundFile)
        {
            if (!soundFile)
                return "";

            if (soundFile->type == SAT_LOADED)
                return soundFile->u.loadSnd ? dumping::ReferencedAssetName(soundFile->u.loadSnd->name) : "";

            const auto dir = Str(soundFile->u.streamSnd.dir);
            const auto name = Str(soundFile->u.streamSnd.name);

            if (dir.empty())
                return name;

            return std::format("{}/{}", dir, name);
        }

        static std::string SoundFileType(const SoundFile* soundFile)
        {
            if (!soundFile)
                return "";

            return soundFile->type == SAT_LOADED ? "loaded" : "streamed";
        }

        void DumpAlias(const snd_alias_t& alias)
        {
            m_csv.WriteColumn(Str(alias.aliasName));
            m_csv.WriteColumn(Num(alias.sequence));
            m_csv.WriteColumn(SoundFileName(alias.soundFile));
            m_csv.WriteColumn(Num(alias.volMin));
            m_csv.WriteColumn(Num(alias.volMax));
            m_csv.WriteColumn(Num(alias.pitchMin));
            m_csv.WriteColumn(Num(alias.pitchMax));
            m_csv.WriteColumn(Num(alias.distMin));
            m_csv.WriteColumn(Num(alias.distMax));
            m_csv.WriteColumn(Num(static_cast<int>(snd_alias_flags::Channel(alias.flags))));
            m_csv.WriteColumn(SoundFileType(alias.soundFile));
            m_csv.WriteColumn(Num(alias.probability));
            m_csv.WriteColumn(snd_alias_flags::IsLooping(alias.flags) ? "looping" : "nonlooping");
            m_csv.WriteColumn(snd_alias_flags::IsMaster(alias.flags) ? "master" : "");

            m_csv.WriteColumn("");
            m_csv.WriteColumn(Str(alias.subtitle));
            m_csv.WriteColumn("");

            m_csv.WriteColumn(Str(alias.secondaryAliasName));
            m_csv.WriteColumn(Str(alias.chainAliasName));
            m_csv.WriteColumn(Str(alias.mixerGroup));
            m_csv.WriteColumn(alias.volumeFalloffCurve ? dumping::ReferencedAssetName(alias.volumeFalloffCurve->filename) : "");
            m_csv.WriteColumn(Num(alias.startDelay));
            m_csv.WriteColumn(alias.speakerMap ? Str(alias.speakerMap->name) : "");

            m_csv.WriteColumn(snd_alias_flags::Reverb(alias.flags));

            m_csv.WriteColumn(Num(alias.lfePercentage));
            m_csv.WriteColumn(Num(alias.centerPercentage));
            m_csv.WriteColumn("");
            m_csv.WriteColumn(Num(alias.envelopMin));
            m_csv.WriteColumn(Num(alias.envelopMax));
            m_csv.WriteColumn(Num(alias.envelopPercentage));
            m_csv.WriteColumn(Num(alias.velocityMin));

            m_csv.WriteColumn(Num(alias.masterPercentage));

            const auto unrecovered = static_cast<uint32_t>(alias.flags) & snd_alias_flags::UNRECOVERED_MASK;
            m_csv.WriteColumn(unrecovered ? std::format("{:#x}", unrecovered) : "");

            WriteSpeakerMap(alias);

            m_csv.NextRow();
        }

#ifdef FEATURE_IW4MS
        void WriteSpeakerMap(const snd_alias_t& alias)
        {
            if (!alias.speakerMap)
            {
                for (auto i = 0u; i < 5u; i++)
                    m_csv.WriteColumn("");
                return;
            }

            m_csv.WriteColumn(alias.speakerMap->isDefault ? "1" : "0");

            for (const auto& channelMap : alias.speakerMap->channelMaps)
            {
                for (const auto& speakers : channelMap.speakers)
                    m_csv.WriteColumn(SpeakerLevels(speakers));
            }
        }

        [[nodiscard]] static std::string SpeakerLevels(const MSSSpeakerLevels& speakers)
        {
            std::string result;

            for (auto i = 0u; i < static_cast<unsigned char>(speakers.levelCount) && speakers.levels; i++)
            {
                const auto& level = speakers.levels[i];

                if (!result.empty())
                    result += ' ';

                result += std::format("{}:{}:{}", static_cast<int>(level.channel), static_cast<int>(level.speaker), Num(level.gain));
            }

            return result;
        }
#else
        void WriteSpeakerMap(const snd_alias_t& alias)
        {
            if (!alias.speakerMap)
            {
                for (auto i = 0u; i < 5u; i++)
                    m_csv.WriteColumn("");
                return;
            }

            m_csv.WriteColumn(alias.speakerMap->isDefault ? "1" : "0");

            for (const auto& channelMaps : alias.speakerMap->channelMaps)
            {
                for (const auto& channelMap : channelMaps)
                    m_csv.WriteColumn(SpeakerLevels(channelMap));
            }
        }

        [[nodiscard]] static std::string SpeakerLevels(const MSSChannelMap& channelMap)
        {
            std::string result;

            const auto speakerCount = std::min(static_cast<size_t>(channelMap.speakerCount), std::extent_v<decltype(channelMap.speakers)>);
            for (auto i = 0u; i < speakerCount; i++)
            {
                const auto& speakers = channelMap.speakers[i];

                if (!result.empty())
                    result += ' ';

                result += Num(speakers.speaker);

                const auto levelCount = std::min(static_cast<size_t>(speakers.numLevels), std::extent_v<decltype(speakers.levels)>);
                for (auto j = 0u; j < levelCount; j++)
                    result += std::format(":{}", Num(speakers.levels[j]));
            }

            return result;
        }
#endif

        CsvOutputStream m_csv;
    };
} // namespace

#set CLASS_NAME "CsvDumper" + GAME

namespace sound
{
    void CLASS_NAME::DumpAsset(AssetDumpingContext& context, const XAssetInfo<AssetSound::Type>& asset)
    {
        const auto assetFile = context.OpenAssetFile(sound::GetSoundAliasCsvFileNameForAssetName(asset.m_name));

        if (!assetFile)
            return;

        Dumper dumper(*assetFile);
        dumper.Dump(*asset.Asset());
    }
} // namespace sound
