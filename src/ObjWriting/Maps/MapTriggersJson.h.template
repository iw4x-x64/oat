#options GAME (IW4, IW4MS)

#filename "Game/" + GAME + "/Maps/MapTriggersJson" + GAME + ".h"

#set GAME_HEADER "\"Game/" + GAME + "/" + GAME + ".h\""
#set CREATE_TRIGGERS_JSON "CreateTriggersJson" + GAME

// This file was templated.
// See MapTriggersJson.h.template.
// Do not modify, changes will be lost.

#pragma once

#include GAME_HEADER
#include "World/WorldJsonCommon.h"

#include <nlohmann/json.hpp>

namespace map_ents
{
    [[nodiscard]] inline nlohmann::json CREATE_TRIGGERS_JSON(const GAME::MapTriggers& triggers)
    {
        return nlohmann::json{
            {"models",
             world::Array(triggers.models,
             triggers.count,
             [](const GAME::TriggerModel& model)
                          {
                              return nlohmann::json{
                                  {                                "contents",                model.contents},
                                  { "hullCount", model.hullCount},
                                  {"firstHull", model.firstHull},
                              };
                          })},
            {"hulls",
             world::Array(triggers.hulls,
             triggers.hullCount,
             [](const GAME::TriggerHull& hull)
                          {
                              return nlohmann::json{
                                  {"bounds", world::Bounds(hull.bounds)},
                                  {"contents", hull.contents},
                                  {"slabCount", hull.slabCount},
                                  {"firstSlab", hull.firstSlab},
                              };
                          })},
            {"slabs",
             world::Array(triggers.slabs,
             triggers.slabCount,
             [](const GAME::TriggerSlab& slab)
                          {
                              return nlohmann::json{
                                  {"dir", world::Vec3(slab.dir)},
                                  {"midPoint", slab.midPoint},
                                  {"halfSize", slab.halfSize},
                              };
                          })},
        };
    }
} // namespace map_ents
