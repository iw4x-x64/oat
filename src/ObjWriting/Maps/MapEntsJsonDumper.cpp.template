#options GAME (IW4, IW4MS)

#filename "Game/" + GAME + "/Maps/MapEntsJsonDumper" + GAME + ".cpp"

#set DUMPER_HEADER "\"MapEntsJsonDumper" + GAME + ".h\""
#set CLASS_NAME "JsonDumper" + GAME
#set CREATE_TRIGGERS_JSON "CreateTriggersJson" + GAME
#set TRIGGERS_HEADER "\"MapTriggersJson" + GAME + ".h\""

// This file was templated.
// See MapEntsJsonDumper.cpp.template.
// Do not modify, changes will be lost.

#include DUMPER_HEADER

#include "Dumping/AssetDumpingContext.h"
#include TRIGGERS_HEADER
#include "Maps/MapEntsCommon.h"

#include <iomanip>
#include <nlohmann/json.hpp>

using namespace nlohmann;
using namespace GAME;

namespace map_ents
{
    void CLASS_NAME::DumpAsset(AssetDumpingContext& context, const XAssetInfo<AssetMapEnts::Type>& asset)
    {
        const auto assetFile = context.OpenAssetFile(GetTriggersFileNameForAssetName(asset.m_name));
        if (!assetFile)
            return;

        const auto* mapEnts = asset.Asset();

        json jRoot;
        jRoot["_type"] = "mapents";
        jRoot["_version"] = 1;
        jRoot["_game"] = "iw4";

        jRoot["trigger"] = CREATE_TRIGGERS_JSON(mapEnts->trigger);

        jRoot["stages"] = world::Array(mapEnts->stages,
                                       static_cast<size_t>(mapEnts->stageCount),
                                       [](const Stage& stage)
                                       {
                                           return json{
                                               {"name",                 stage.name ? stage.name : ""                },
                                               {"origin",               world::Vec3(stage.origin)                   },
                                               {"triggerIndex",         stage.triggerIndex                          },
                                               {"sunPrimaryLightIndex", static_cast<int>(stage.sunPrimaryLightIndex)},
                                           };
                                       });

        *assetFile << std::setw(4) << jRoot << "\n";
    }
} // namespace map_ents
