#options GAME (IW3, IW4, IW4MS, IW5, T4, T5, T6)

#filename "Game/" + GAME + "/Image/ImageLoaderExternal" + GAME + ".cpp"

#if GAME == "IW3"
#define FEATURE_IW3
#elif GAME == "IW4"
#define FEATURE_IW4
#elif GAME == "IW4MS"
// IW4MS shares the IW4 content model, so it takes the same branches as IW4.
#define FEATURE_IW4MS
#define FEATURE_IW4
#elif GAME == "IW5"
#define FEATURE_IW5
#elif GAME == "T4"
#define FEATURE_T4
#elif GAME == "T5"
#define FEATURE_T5
#elif GAME == "T6"
#define FEATURE_T6
#endif

#if defined(FEATURE_IW3) || defined(FEATURE_T4)
#define IWI_VERSION IWI_6
#elif defined(FEATURE_IW4) || defined(FEATURE_IW5)
#define IWI_VERSION IWI_8
#elif defined(FEATURE_T5)
#define IWI_VERSION IWI_13
#elif defined(FEATURE_T6)
#define IWI_VERSION IWI_27
#endif

#if defined(FEATURE_T6)
#define HASH_TYPE CRC32
#else
#define HASH_TYPE NONE
#endif


// This file was templated.
// See ImageLoaderExternal.cpp.template.
// Do not modify, changes will be lost.

#set LOADER_HEADER "\"ImageLoaderExternal" + GAME + ".h\""
#include LOADER_HEADER

#set COMMON_HEADER "\"Game/" + GAME + "/Common" + GAME + ".h\""
#include COMMON_HEADER
#include "Image/ImageLoaderCommon.h"
#include "Image/IwiTypes.h"
#include "Utils/Logging/Log.h"

#include <cstring>

using namespace GAME;
using namespace image;

namespace
{
#set LOADER_CLASS "ImageLoader" + GAME
    class LOADER_CLASS final : public AssetCreator<AssetImage>
    {
    public:
        LOADER_CLASS(MemoryManager& memory, ISearchPath& searchPath)
            : m_memory(memory),
              m_search_path(searchPath)
        {
        }

        AssetCreationResult CreateAsset(const std::string& assetName, AssetCreationContext& context) override
        {
            const auto loadingResult = LoadImageCommon(assetName, m_search_path, IwiVersion::IWI_VERSION, CommonImageLoaderHashType::HASH_TYPE);
            const auto earlyReturn = loadingResult.GetResultIfCancelled();
            if (earlyReturn)
                return *earlyReturn;

            const auto* texture = loadingResult.m_texture.get();

            auto* image = m_memory.Alloc<GfxImage>();
            image->name = m_memory.Dup(assetName.c_str());
#ifdef FEATURE_T6
            image->hash = Common::R_HashString(image->name, 0);
#endif
#ifndef FEATURE_IW5
            image->delayLoadPixels = true;
#endif

            image->noPicmip = loadingResult.m_meta.m_no_picmip;
            image->width = static_cast<uint16_t>(texture->GetWidth());
            image->height = static_cast<uint16_t>(texture->GetHeight());
            image->depth = static_cast<uint16_t>(texture->GetDepth());

#ifdef FEATURE_T6
            image->streaming = 1;
            image->streamedParts[0].levelCount = 1;
            image->streamedParts[0].levelSize = static_cast<uint32_t>(loadingResult.m_iwi_size);
            image->streamedParts[0].hash = loadingResult.m_hash.crc32 & 0x1FFFFFFF;
            image->streamedPartCount = 1;
#endif

#ifdef FEATURE_IW4MS
            // IW4MS keeps the pixels in the zone. Retail x64 fastfiles embed every
            // image they carry, and a delay-load image, which on x86 is streamed
            // from an IWD, reaches the x64 renderer with no texture behind it:
            // drawing one faults on the missing base map. So the iwi read above is
            // written into the load definition, the way the retail zones hold it.
            //
            EmbedPixels(*image, *texture, loadingResult.m_meta);
#else
            image->texture.loadDef = m_memory.Alloc<GfxImageLoadDef>();
#endif

            return AssetCreationResult::Success(context.AddAsset<AssetImage>(assetName, image));
        }

#ifdef FEATURE_IW4MS
        void EmbedPixels(GfxImage& image, const Texture& texture, const CommonIwiMetaData& meta) const
        {
            image.delayLoadPixels = false;

            image.category = IMG_CATEGORY_LOAD_FROM_FILE;
            image.semantic = TS_2D;
            image.picmip.platform[0] = 0;
            image.picmip.platform[1] = 0;
            image.noPicmip = meta.m_no_picmip;

            switch (texture.GetTextureType())
            {
            case TextureType::T_2D:
                image.mapType = MAPTYPE_2D;
                break;

            case TextureType::T_3D:
                image.mapType = MAPTYPE_3D;
                break;

            case TextureType::T_CUBE:
                image.mapType = MAPTYPE_CUBE;
                break;

            default:
                image.mapType = MAPTYPE_NONE;
                break;
            }

            const auto mipCount = texture.HasMipMaps() ? texture.GetMipMapCount() : 1;
            const auto faceCount = texture.GetFaceCount();

            auto dataSize = 0uz;
            for (auto mipLevel = 0; mipLevel < mipCount; mipLevel++)
                dataSize += texture.GetSizeOfMipLevel(mipLevel) * faceCount;

            image.cardMemory.platform[0] = static_cast<int>(dataSize);
            image.cardMemory.platform[1] = static_cast<int>(dataSize);

            auto* loadDef = static_cast<GfxImageLoadDef*>(m_memory.AllocRaw(offsetof(GfxImageLoadDef, data) + dataSize));
            image.texture.loadDef = loadDef;
            loadDef->levelCount = static_cast<char>(mipCount);
            loadDef->flags = 0;
            if (!texture.HasMipMaps())
                loadDef->flags |= iwi8::IMG_FLAG_NOMIPMAPS;
            if (texture.GetTextureType() == TextureType::T_CUBE)
                loadDef->flags |= iwi8::IMG_FLAG_MAPTYPE_CUBE;
            if (texture.GetTextureType() == TextureType::T_3D)
                loadDef->flags |= iwi8::IMG_FLAG_MAPTYPE_3D;
            loadDef->format = static_cast<int>(texture.GetFormat()->GetD3DFormat());
            loadDef->resourceSize = static_cast<unsigned>(dataSize);

            char* currentDataBuffer = loadDef->data;
            for (auto mipLevel = 0; mipLevel < mipCount; mipLevel++)
            {
                const auto mipSize = texture.GetSizeOfMipLevel(mipLevel);

                for (auto face = 0; face < faceCount; face++)
                {
                    memcpy(currentDataBuffer, texture.GetBufferForMipLevel(mipLevel, face), mipSize);
                    currentDataBuffer += mipSize;
                }
            }
        }
#endif

        MemoryManager& m_memory;
        ISearchPath& m_search_path;
    };
} // namespace

namespace image
{
#set LOADER_METHOD "CreateLoaderExternal" + GAME
    std::unique_ptr<AssetCreator<AssetImage>> LOADER_METHOD(MemoryManager& memory, ISearchPath& searchPath)
    {
        return std::make_unique<LOADER_CLASS>(memory, searchPath);
    }
} // namespace image
