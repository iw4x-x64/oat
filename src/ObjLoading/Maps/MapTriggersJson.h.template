#options GAME (IW4, IW4MS)

#filename "Game/" + GAME + "/Maps/MapTriggersJson" + GAME + ".h"

#set GAME_HEADER "\"Game/" + GAME + "/" + GAME + ".h\""
#set LOAD_TRIGGERS_JSON "LoadTriggersJson" + GAME

// This file was templated.
