#pragma once

#include <cstdint>

namespace GAME
{
    namespace fx_elem_flags
    {
        inline constexpr uint32_t SPAWN_RELATIVE       = 1u << 1u;
        inline constexpr uint32_t SPAWN_FRUSTUM_CULL   = 1u << 2u;
        inline constexpr uint32_t RUNNER_USES_RAND_ROT = 1u << 3u;
        inline constexpr unsigned SPAWN_OFFSET_SHIFT   = 4u;
        inline constexpr uint32_t SPAWN_OFFSET_MASK    = 0x3u;

        enum class SpawnOffset : uint32_t
        {
            NONE = 0,
            SPHERE = 1,
            CYLINDER = 2,
        };

        inline constexpr unsigned RUN_REL_TO_SHIFT = 6u;
        inline constexpr uint32_t RUN_REL_TO_MASK  = 0x3u;

        enum class RunRelTo : uint32_t
        {
            WORLD = 0,
            SPAWN = 1,
            EFFECT = 2,
            OFFSET = 3,
        };

        inline constexpr uint32_t USE_COLLISION        = 1u << 8u;
        inline constexpr uint32_t DIE_ON_TOUCH         = 1u << 9u;
        inline constexpr uint32_t DRAW_PAST_FOG        = 1u << 10u;
        inline constexpr uint32_t BLOCKS_SIGHT         = 1u << 12u;
        inline constexpr uint32_t DRAW_WITH_VIEW_MODEL = 1u << 11u;
        inline constexpr uint32_t MODEL_USES_PHYSICS   = 1u << 27u;
        inline constexpr uint32_t NON_UNIFORM_SCALE    = 1u << 28u;

        [[nodiscard]] inline SpawnOffset GetSpawnOffset(const int flags)
        {
            return static_cast<SpawnOffset>((static_cast<uint32_t>(flags) >> SPAWN_OFFSET_SHIFT) & SPAWN_OFFSET_MASK);
        }

        [[nodiscard]] inline RunRelTo GetRunRelTo(const int flags)
        {
            return static_cast<RunRelTo>((static_cast<uint32_t>(flags) >> RUN_REL_TO_SHIFT) & RUN_REL_TO_MASK);
        }

        [[nodiscard]] inline bool HasFlag(const int flags, const uint32_t bit)
        {
            return (static_cast<uint32_t>(flags) & bit) != 0u;
        }

        inline constexpr uint32_t RECOVERED_MASK = SPAWN_RELATIVE
                                                 | SPAWN_FRUSTUM_CULL
                                                 | RUNNER_USES_RAND_ROT
                                                 | (SPAWN_OFFSET_MASK << SPAWN_OFFSET_SHIFT)
                                                 | (RUN_REL_TO_MASK << RUN_REL_TO_SHIFT)
                                                 | USE_COLLISION
                                                 | DIE_ON_TOUCH
                                                 | DRAW_PAST_FOG
                                                 | DRAW_WITH_VIEW_MODEL
                                                 | BLOCKS_SIGHT
                                                 | MODEL_USES_PHYSICS
                                                 | NON_UNIFORM_SCALE;

        inline constexpr uint32_t UNRECOVERED_MASK = ~RECOVERED_MASK;
    } // namespace fx_elem_flags

    namespace fx_atlas_behavior
    {
        inline constexpr unsigned START_MASK = 0x3u;

        enum class Start : uint8_t
        {
            FIXED = 0,   ///< atlas.index
            RANDOM = 1,  ///< a random entry per element
            INDEXED = 2, ///< an entry carried by the element itself
        };

        inline constexpr uint8_t PLAY_OVER_LIFE = 0x4u;
        inline constexpr uint8_t LOOP_ONLY_N_TIMES = 0x8u;

        [[nodiscard]] inline Start GetStart(const char behavior)
        {
            return static_cast<Start>(static_cast<uint8_t>(behavior) & START_MASK);
        }

        [[nodiscard]] inline bool HasFlag(const char behavior, const uint8_t bit)
        {
            return (static_cast<uint8_t>(behavior) & bit) != 0u;
        }
    } // namespace fx_atlas_behavior
